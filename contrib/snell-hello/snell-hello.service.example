[Unit]
Description=Experimental Snell hello carrier receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snell-hello
Group=snell-hello
ExecStart=/opt/snell-hello/snell-hello -config /etc/snell-hello/config.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
