--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/utils/LibboxInitializer.kt
@@ -0,0 +1,16 @@
+package io.nekohasekai.sfa.utils
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+
+/** Shares one application-owned setup task across UI and system service starts. */
+internal class LibboxInitializer(scope: CoroutineScope, initialize: suspend () -> Unit) {
+    private val initialized = scope.async(Dispatchers.IO, start = CoroutineStart.LAZY) {
+        initialize()
+    }
+
+    // A cancelled waiter must not cancel setup; failures reach every caller.
+    suspend fun await() = initialized.await()
+}
