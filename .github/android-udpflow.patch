+
+// Android installs updates by versionCode. Release names deliberately keep the
+// official version plus -udpflow, so comparing only names can miss an update.
+internal fun selectUdpflowUpdate(
+    releases: List<GitHubUpdateChecker.GitHubRelease>,
+    track: UpdateTrack,
+    currentVersionCode: Int,
+    metadataFor: (GitHubUpdateChecker.GitHubRelease) -> GitHubUpdateChecker.VersionMetadata?,
+): UpdateInfo? {
+    var selected: UpdateInfo? = null
+    for (release in releases) {
+        if (release.draft || (track == UpdateTrack.STABLE && release.prerelease)) continue
+        val metadata = metadataFor(release) ?: continue
+        if (metadata.versionCode <= currentVersionCode || metadata.versionCode <= (selected?.versionCode ?: 0)) continue
+        if (release.tagName != "v${metadata.versionName}") continue
+        val apk = release.assets.singleOrNull { it.name == "SFA-${metadata.versionName}-arm64-v8a.apk" } ?: continue
+        selected = UpdateInfo(
+            versionCode = metadata.versionCode,
+            versionName = metadata.versionName,
+            downloadUrl = apk.browserDownloadUrl,
+            releaseUrl = release.htmlUrl,
+            releaseNotes = release.body,
+            isPrerelease = release.prerelease,
+            fileSize = apk.size,
+        )
+    }
+    return selected
 }
