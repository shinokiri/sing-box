+package io.nekohasekai.sfa.compose.model
+
+// Wire values from daemon.GroupItem.urlTestState.
+object UrlTestState {
+    const val IDLE = 0
+    const val QUEUED = 1
+    const val RUNNING = 2
+    const val SUCCEEDED = 3
+    const val FAILED = 4
+    const val CANCELED = 5
+}
+
+// Hide old values immediately, including nested groups and nodes still queued
+// behind the concurrency limit. IDs let a coalesced final update acknowledge a
+// fast test even when the UI never received its intermediate running state.
+fun urlTestBaselines(groups: List<Group>, tag: String): Map<String, Long> {
+    if (groups.none { it.urlTestProgressSupported }) return emptyMap()
+    val ids = urlTestIds(groups)
+    val byTag = groups.associateBy { it.tag }
+    val targets = linkedMapOf<String, Long>()
+    fun collect(target: String) {
+        if (target in targets) return
+        targets[target] = ids[target] ?: 0
+        byTag[target]?.items?.forEach { collect(it.tag) }
+    }
+    collect(tag)
+    return targets
+}
+
+fun pendingUrlTests(groups: List<Group>, pending: Map<String, Long>): Map<String, Long> {
+    val ids = urlTestIds(groups)
+    return pending.filter { (tag, baseline) -> ids[tag]?.let { it <= baseline } == true }
+}
+
+fun displayUrlTestProgress(groups: List<Group>, pending: Map<String, Long>): List<Group> = if (pending.isEmpty()) groups else groups.map { group ->
+    group.copy(
+        urlTestRunning = group.urlTestRunning || group.tag in pending,
+        items = group.items.map { item ->
+            if (item.tag in pending) {
+                item.copy(urlTestDelay = 0, urlTestState = UrlTestState.QUEUED)
+            } else {
+                item
+            }
+        },
+    )
+}
+
+private fun urlTestIds(groups: List<Group>): Map<String, Long> = buildMap {
+    groups.forEach { group ->
+        put(group.tag, maxOf(get(group.tag) ?: 0, group.urlTestId))
+        group.items.forEach { item -> put(item.tag, maxOf(get(item.tag) ?: 0, item.urlTestId)) }
+    }
+}
